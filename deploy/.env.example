# Copy to deploy/.env and fill in. `make up` reads TLS_MODE as the compose profile.

# tailscale (default): reachable on your tailnet at https://dotion.<tailnet>.ts.net
TLS_MODE=tailscale
TS_AUTHKEY=tskey-auth-...
DIARY_OWNER_LOGIN=you@github

# off: this machine only, password sign-in. Set TLS_MODE=off and fill these in.
# DIARY_PASSWORD_HASH=
# DIARY_TOKEN_SECRET=

# Google Calendar and Drive (optional). Create an OAuth client ID of type
# "Web application" in Google Cloud Console; Settings → Google Calendar in the
# app shows the exact redirect URI to register.
# DIARY_GOOGLE_CLIENT_ID=
# DIARY_GOOGLE_CLIENT_SECRET=
# DIARY_PUBLIC_URL=https://dotion.<your-tailnet>.ts.net

# AI assistant and action items (optional). Set ONE of these; if several are
# set, Claude wins, then Ollama, then Gemini.
#
# Claude (recommended): create a key at console.anthropic.com → Settings → API keys.
# DIARY_ANTHROPIC_API_KEY=sk-ant-...
# DIARY_ANTHROPIC_MODEL=claude-opus-5-5
#
# A local model through Ollama (needs a strong GPU on the machine running it):
# DIARY_OLLAMA_URL=http://host.docker.internal:11434
# DIARY_OLLAMA_MODEL=qwen3:14b
#
# Google Gemini: create a key in Google AI Studio (aistudio.google.com).
# DIARY_GEMINI_API_KEY=
# DIARY_GEMINI_MODEL=gemini-3.8-flash
